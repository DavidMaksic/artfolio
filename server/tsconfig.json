{
   "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "lib": ["ES2022"],
      "outDir": "./dist",
      "rootDir": "./src",
      "types": ["node"],
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "paths": {
         "@/*": ["./src/*"],
         "@artfolio/shared": ["../shared/src/index.ts"]
      }
   },
   "include": ["src"],
   "exclude": ["node_modules", "dist"]
}
