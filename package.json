{
   "name": "artfolio",
   "private": true,
   "workspaces": [
      "client",
      "server",
      "shared"
   ],
   "scripts": {
      "predev": "docker compose up -d",
      "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
      "build": "npm run build --workspaces",
      "typecheck": "npm run typecheck --workspaces",
      "lint": "npm run lint --workspaces",
      "test": "npm run test:unit && npm run test:e2e",
      "test:unit": "npm run test:server && npm run test:client",
      "test:server": "npm run test:unit --workspace=server",
      "test:client": "npm run test:unit --workspace=client",
      "test:e2e": "npm run test:e2e --workspace=client"
   },
   "devDependencies": {
      "@types/supertest": "^7.2.0",
      "concurrently": "^10.0.3",
      "supertest": "^7.2.2"
   },
   "dependencies": {
      "better-auth": "^1.6.24"
   },
   "overrides": {
      "esbuild": "^0.25.0",
      "shell-quote": "^1.8.5"
   },
   "engines": {
      "node": "^24.0.0",
      "npm": ">=11"
   }
}
